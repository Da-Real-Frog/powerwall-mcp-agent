# Copy to src/server/.env (local runs) or to the env file on the Docker host, then fill in.
# Never commit the filled-in copy. Put comments on their own lines: Docker's --env-file
# does not strip inline comments.

# Local Powerwall gateway
PW_HOST=192.168.1.x
PW_PASSWORD=
PW_EMAIL=
# Optional: the gateway's Wi-Fi password from its label, for per-string data on both
# inverters. Needs a route from the Docker host to 192.168.91.1 (see README).
PW_GW_PWD=
# Optional, defaults to America/Chicago
# PW_TIMEZONE=America/Chicago

# Home location, used for the solar forecast and NWS alerts
SOLAR_LAT=
SOLAR_LON=

# Optional alerts: full ntfy topic URL (a hard-to-guess topic), token if the topic is protected
NTFY_URL=
NTFY_TOKEN=
# Optional dead-man check URL, e.g. a healthchecks.io ping URL
HEARTBEAT_URL=
