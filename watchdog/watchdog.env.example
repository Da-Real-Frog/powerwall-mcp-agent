# Copy to ~/watchdog/watchdog.env on the Pi and `chmod 600` it. Never commit the real file.

# percula's fixed IP address. Names ending in .local don't resolve inside the container.
PERCULA_HOST=
# The account on percula whose authorized_keys holds the watchdog key
PERCULA_USER=

# The same full topic URL as NTFY_URL in percula's mcp-server.env; NTFY_TOKEN only if the topic is protected
NTFY_URL=
NTFY_TOKEN=

# Optional: when to check (24-hour local time) and which timezone
CHECK_AT=12:00
TZ=America/Chicago

# Optional: containers that must be running (comma-separated)
EXPECTED_CONTAINERS=mcp-server,home-chat

# Optional: URLs that must answer. Empty means Home Chat (8080) and the MCP server (8000) on
# PERCULA_HOST; "none" turns the web checks off.
HTTP_CHECKS=

# Optional: a dead-man URL (e.g. a healthchecks.io ping URL) pinged after each check, so a
# silent Pi raises its own alert even if you miss that the noon message didn't come
HEARTBEAT_URL=
