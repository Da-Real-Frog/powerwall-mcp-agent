# Copy to web/.env (local runs) or to the env file on the Docker host, then fill in.
# Never commit the filled-in copy. Put comments on their own lines: Docker's --env-file
# does not strip inline comments.

# Claude API key. It stays on this server; the phone never sees it.
ANTHROPIC_API_KEY=
# The MCP server. In Docker on percula the deploy workflow sets this to the host's port 8000.
MCP_SERVER_URL=http://percula.local:8000/mcp
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
